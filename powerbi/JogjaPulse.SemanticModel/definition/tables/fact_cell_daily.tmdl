table fact_cell_daily

	column cell_id
		dataType: string
		summarizeBy: none
		sourceColumn: cell_id

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

	column n_maids
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: n_maids

	column share
		dataType: double
		formatString: 0.000%
		summarizeBy: none
		sourceColumn: share

	partition fact_cell_daily = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\fact_cell_daily.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Selected = Table.SelectColumns(Promoted, {"cell_id", "date", "n_maids", "share"}),
				Typed = Table.TransformColumnTypes(Selected, {{"cell_id", type text}, {"date", type date}, {"n_maids", Int64.Type}, {"share", type number}}, "en-US")
			in
				Typed
