table dim_date

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

	column weekday
		dataType: string
		summarizeBy: none
		sourceColumn: weekday

	column weekday_num
		dataType: int64
		summarizeBy: none
		sourceColumn: weekday_num

	column month
		dataType: string
		summarizeBy: none
		sourceColumn: month

	column is_weekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	column is_holiday
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_holiday

	column holiday_name
		dataType: string
		summarizeBy: none
		sourceColumn: holiday_name

	column day_type
		dataType: string
		summarizeBy: none
		sourceColumn: day_type

	column precipitation_sum
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: precipitation_sum

	column temperature_2m_mean
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: temperature_2m_mean

	column temperature_2m_max
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: temperature_2m_max

	column rain_class
		dataType: string
		summarizeBy: none
		sourceColumn: rain_class

	column anomaly_flag
		dataType: boolean
		summarizeBy: none
		sourceColumn: anomaly_flag

	partition dim_date = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Selected = Table.SelectColumns(Promoted, {"date", "weekday", "weekday_num", "month", "is_weekend", "is_holiday", "holiday_name", "day_type", "precipitation_sum", "temperature_2m_mean", "temperature_2m_max", "rain_class", "anomaly_flag"}),
				Typed = Table.TransformColumnTypes(Selected, {{"date", type date}, {"weekday", type text}, {"weekday_num", Int64.Type}, {"month", type text}, {"is_weekend", type logical}, {"is_holiday", type logical}, {"holiday_name", type text}, {"day_type", type text}, {"precipitation_sum", type number}, {"temperature_2m_mean", type number}, {"temperature_2m_max", type number}, {"rain_class", type text}, {"anomaly_flag", type logical}}, "en-US")
			in
				Typed
